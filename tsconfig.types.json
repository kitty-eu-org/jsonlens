{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    "types": ["react"]
  },
  "include": ["types/**/*.tsx", "packages/*/index.d.ts", "packages/*/engines.d.ts"]
}
